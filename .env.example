# =====================================================================
# VibeCheck AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with your credentials.
# NEVER commit .env to version control!
# =====================================================================

# AI Provider API Base URL (HTTPS only, e.g. OpenAI, Groq, OpenRouter, or Gemini OpenAI-compatible)
AI_BASE_URL=https://api.openai.com/v1

# AI Model Identifier
AI_MODEL=gpt-4o-mini

# AI API Key (Bearer token for HTTPS authorization header)
AI_API_KEY=your_api_key_here

# Request Timeout in seconds (Default: 20)
AI_TIMEOUT_SECONDS=20

# Max retries for transient errors (429 rate limit, 5xx server errors; Default: 2)
AI_MAX_RETRIES=2

# Prompt & Schema Version (increment when changing prompts to invalidate outdated cache)
PROMPT_SCHEMA_VERSION=v1.0.0

# Local Storage Directory
STORAGE_DIR=storage
